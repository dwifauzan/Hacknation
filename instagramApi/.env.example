# Copy to .env — NEVER commit the real .env (it holds secrets).
# cp .env.example .env

# --- AI provider (Groq) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=400

# --- Store information and AI response rules ---
STORE_NAME=Nama Toko
STORE_HOURS="Senin-Sabtu 09.00-18.00 WIB; Minggu tutup"
STORE_ADDRESS="Isi alamat toko"
STORE_PRODUCTS="Isi produk atau layanan utama"
AI_LANGUAGE=Bahasa Indonesia
AI_TONE="ramah, singkat, natural, dan menggunakan panggilan kak"
# Separate multiple rules with semicolons.
AI_EXTRA_RULES="Jangan menyebut harga sebelum pelanggan menyebut produk; arahkan komplain ke admin manusia"

# --- Bot behaviour ---
# Kill switch: set to 1 to stop all auto-replies without touching code.
AUTOREPLY_ENABLED=1
# Accept incoming DM requests from people you don't follow, so the bot can
# read + reply to them like any other message. This only approves the DM
# thread — it never follows anyone.
AUTOREPLY_ACCEPT_REQUESTS=1
# Seconds between Instagram inbox polls. Too small = action block. Keep >= 20.
POLL_INTERVAL_SECONDS=30
# Max threads fetched each poll (per inbox: main + requests).
POLL_INBOX_SIZE=20
# Minimum seconds between two replies in the SAME thread.
REPLY_MIN_GAP_SECONDS=20
# Max replies per thread per hour.
REPLY_MAX_PER_THREAD_PER_HOUR=10
# Comma-separated phrases that force a human handoff (no auto-reply).
HANDOFF_KEYWORDS=komplain,refund,penipuan,lapor,manusia,admin asli

# --- Storage ---
# SQLite file used for the dedupe store + reply log.
AUTOREPLY_DB=autoreply.sqlite3
